<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uhl.playerdb.controller.WelcomeController">
   <children>
      <Button fx:id="loginButton" layoutX="256.0" layoutY="260.0" mnemonicParsing="false" onAction="#handleLogin" text="Login">
         <font>
            <Font size="24.0" />
         </font>
      </Button>
      <TextField fx:id="usernameInputField" layoutX="243.0" layoutY="118.0" promptText="Enter name" />
      <Button fx:id="exitButton" layoutX="531.0" layoutY="14.0" mnemonicParsing="false" onAction="#handleExit" text="Exit" />
      <PasswordField fx:id="passwordInputField" layoutX="243.0" layoutY="165.0" promptText="Enter password" />
      <Label layoutX="172.0" layoutY="122.0" text="Name" />
      <Label layoutX="172.0" layoutY="169.0" text="Password" />
   </children>
</AnchorPane>
