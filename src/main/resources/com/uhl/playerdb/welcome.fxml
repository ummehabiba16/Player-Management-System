<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #f4f0e0;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uhl.playerdb.controller.WelcomeController">
   <children>
      <Button fx:id="loginButton" layoutX="310.0" layoutY="281.0" mnemonicParsing="false" onAction="#handleLogin" style="-fx-background-color: #4CAF50; -fx-border-radius: 32;" text="Login" textFill="WHITE">
         <font>
            <Font name="American Typewriter" size="20.0" />
         </font>
         <style>
            .button:hover {
            -fx-scale-x: 1.2;
            -fx-scale-y: 1.2;
            }
         </style>
      </Button>
      <TextField fx:id="usernameInputField" layoutX="247.0" layoutY="148.0" onMouseEntered="#onTextFieldFocus" onMouseExited="#onTextFieldExit" prefHeight="44.0" prefWidth="260.0" promptText="Enter name" style="-fx-background-color: #f4f0e0; -fx-border-radius: 16; -fx-border-color: gray;">
         <font>
            <Font name="American Typewriter" size="24.0" />
         </font></TextField>
      <Button fx:id="exitButton" layoutX="202.0" layoutY="281.0" mnemonicParsing="false" onAction="#handleExit" prefHeight="28.0" prefWidth="89.0" style="-fx-background-color: #BA110C; -fx-border-radius: 32;" text="Exit" textFill="WHITE">
         <font>
            <Font name="American Typewriter" size="20.0" />
         </font>
         <style>
            .button:hover {
            -fx-scale-x: 1.2;
            -fx-scale-y: 1.2;
            }
         </style>
      </Button>
      <PasswordField fx:id="passwordInputField" layoutX="247.0" layoutY="202.0" onMouseEntered="#onTextFieldFocus" onMouseExited="#onTextFieldExit" prefHeight="44.0" prefWidth="260.0" promptText="Enter password" style="-fx-background-color: #f4f0e0; -fx-border-radius: 16; -fx-border-color: gray;">
         <font>
            <Font name="American Typewriter" size="24.0" />
         </font></PasswordField>
      <Label layoutX="124.0" layoutY="156.0" text="Name">
         <font>
            <Font name="American Typewriter" size="24.0" />
         </font></Label>
      <Label layoutX="124.0" layoutY="210.0" text="Password">
         <font>
            <Font name="American Typewriter" size="24.0" />
         </font></Label>
      <Label layoutX="77.0" layoutY="42.0" text="Player Management System">
         <font>
            <Font name="American Typewriter Semibold" size="36.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
