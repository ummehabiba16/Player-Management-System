<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uhl.playerdb.controller.WelcomeController">
   <children>
      <Button fx:id="loginButton" layoutX="264.0" layoutY="261.0" mnemonicParsing="false" onAction="#handleLogin" text="Login">
         <font>
            <Font size="24.0" />
         </font>
      </Button>
      <TextField fx:id="usernameInputField" layoutX="228.0" layoutY="117.0" promptText="Enter name" />
      <TextField fx:id="passwordInputField" layoutX="228.0" layoutY="158.0" promptText="Enter Password" />
      <Button fx:id="exitButton" layoutX="531.0" layoutY="14.0" mnemonicParsing="false" onAction="#handleExit" text="Exit" />
   </children>
</AnchorPane>
