<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uhl.playerdb.controller.AddPlayerController">
    <children>
    <Button layoutX="237.0" layoutY="332.0" mnemonicParsing="false" onAction="#onClickBack" text="Back" />
    <TextField fx:id="name" layoutX="120.0" layoutY="48.0" prefHeight="27.0" prefWidth="294.0" promptText="Enter name" />
    <Label layoutX="29.0" layoutY="98.0" text="Country" />
    <TextField fx:id="country" layoutX="120.0" layoutY="93.0" prefHeight="27.0" prefWidth="192.0" promptText="Enter country" />
    <Label layoutX="28.0" layoutY="53.0" text="Name" />
    <Label layoutX="40.0" layoutY="143.0" text="Age" />
    <TextField fx:id="age" layoutX="120.0" layoutY="138.0" prefHeight="27.0" prefWidth="192.0" promptText="Enter age" />
    <Label layoutX="333.0" layoutY="143.0" text="Height" />
    <TextField fx:id="height" layoutX="380.0" layoutY="138.0" prefHeight="27.0" prefWidth="198.0" promptText="Enter height" /><!-- Club dropdown -->
        <Label layoutX="26.0" layoutY="183.0" text="Club" />
        <ComboBox fx:id="clubComboBox" layoutX="120.0" layoutY="178.0" prefHeight="27.0" prefWidth="192.0">
        </ComboBox>

        <Label layoutX="333.0" layoutY="183.0" text="Position" />
        <!-- Position dropdown -->
        <ComboBox fx:id="positionComboBox" layoutX="383.0" layoutY="178.0" prefHeight="27.0" prefWidth="192.0">

        </ComboBox>
    <Label layoutX="19.0" layoutY="237.0" text="Jersey Number" />
    <TextField fx:id="jerseyNumber" layoutX="120.0" layoutY="232.0" prefHeight="27.0" prefWidth="192.0" promptText="Enter Jersey Number (optional)" />

    <Label layoutX="22.0" layoutY="284.0" text="Weekly Salary" />
    <TextField fx:id="weeklySalary" layoutX="120.0" layoutY="280.0" promptText="Enter weekly salary" />


    <Button layoutX="317.0" layoutY="332.0" mnemonicParsing="false" onAction="#onClickAdd" text="Add" />
    <Label layoutX="228.0" layoutY="14.0" text="Add Player">
        <font>
            <Font size="24.0" />
        </font>
    </Label>
    </children>
</AnchorPane>
